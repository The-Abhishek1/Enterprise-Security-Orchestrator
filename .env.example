# ================================================================
# Enterprise Security Orchestrator — .env.example
# Copy to .env and fill in your values.
# Run "make gen-secrets" to generate strong passwords.
# NEVER commit .env to git.
# ================================================================

ENVIRONMENT=production

# ── Security ── generate with: make gen-secrets ───────────────────
JWT_SECRET_KEY=your-64-char-secret-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
API_KEY_HEADER_NAME=X-API-Key

# ── Database ───────────────────────────────────────────────────────
POSTGRES_PASSWORD=strong-password-here
POSTGRES_DSN=postgresql://eso:strong-password-here@localhost:5432/orchestrator
REDIS_PASSWORD=strong-redis-password
REDIS_DSN=redis://:strong-redis-password@localhost:6379/0
RABBITMQ_USER=eso_admin
RABBITMQ_PASSWORD=strong-rabbit-password
RABBITMQ_DSN=amqp://eso_admin:strong-rabbit-password@localhost:5672/

# ── Ports ─────────────────────────────────────────────────────────
API_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ── Rate Limiting + CORS ──────────────────────────────────────────
RATE_LIMIT_ENABLED=true
CORS_ORIGINS=https://yourdomain.com

# ── LLM (local=free Ollama, openai=GPT-4o, anthropic=Claude) ─────
LLM_PROVIDER=local
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5:3b
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_API_KEY=sk-ant-...

# ── Payments ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_your_key
RAZORPAY_KEY_SECRET=your_live_secret

# ── Logging ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
SERVICE_NAME=enterprise-orchestrator

# ── Scanning ───────────────────────────────────────────────────────
ALLOW_PRIVATE_TARGETS=false

# ── Optional ──────────────────────────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# INFLUXDB_URL=http://localhost:8086
# INFLUXDB_TOKEN=your-token
# INFLUXDB_ORG=xcloak
# INFLUXDB_BUCKET=eso_metrics
XCLOAK_URL=app-url
XCLOAK_INTERNAL_SECRET=your-secret

# Add these to Enterprise-Security-Orchestrator/.env
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=your-email
SMTP_PASSWORD=your-password