# ===================================================
# Enterprise Security Orchestrator — Configuration
# ===================================================
# cp .env.example .env && edit

# ===== Environment =====
ENVIRONMENT=development

# ===== LLM Provider =====
# "local" = Ollama (free), "openai" = OpenAI API
LLM_PROVIDER=local

# OpenAI (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4

# Ollama — install: curl -fsSL https://ollama.ai/install.sh | sh && ollama pull qwen2.5:7b
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5:7b

# ===== Auth =====
JWT_SECRET_KEY=change-me-in-production-use-a-random-64-char-string

# ===== Ports =====
API_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ===== Logging =====
LOG_LEVEL=INFO
