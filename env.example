# ===================================================
# Enterprise Security Orchestrator — .env
# ===================================================

# ── Environment ──────────────────────────────────────────
ENVIRONMENT=development

# ── Security ─────────────────────────────────────────────
# Generate a real one: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
API_KEY_HEADER_NAME=X-API-Key

# ── Database ──────────────────────────────────────────────
POSTGRES_DSN=
REDIS_DSN=
RABBITMQ_DSN=

# ── Ports ────────────────────────────────────────────────
API_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_ENABLED=true

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── LLM ──────────────────────────────────────────────────
LLM_PROVIDER=local
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5:3b

# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# ── Payments (Razorpay) ───────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
SERVICE_NAME=enterprise-orchestrator
